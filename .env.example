# =============================================================================
# Database
# =============================================================================
# Neon: use the *pooler* host (…-pooler.…neon.tech) and sslmode=require — avoid channel_binding=require with Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alta_dev?schema=public

# =============================================================================
# Auth / session
# =============================================================================
# Discord OAuth for website sign-in / sign-up (server-only — never expose to the browser).
# Use the Alta Secretary Discord application — not the Bank bot application.
# Prefer DISCORD_OAUTH_CLIENT_ID (falls back to legacy DISCORD_CLIENT_ID).
# Must match the application that owns DISCORD_SECRETARY_BOT_TOKEN.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Production: comma-separate every live callback (Alta Group + each entity domain).
# Example: https://altagroup.dev/api/auth/discord/callback,https://bank.altagroup.dev/api/auth/discord/callback,https://terminal.altagroup.dev/api/auth/discord/callback,https://accounting.altagroup.dev/api/auth/discord/callback
# Register each URI on the Secretary app: Discord Developer Portal → OAuth2 → Redirects.
# Session cookie + OAuth state signing (min 32 characters — generate with: openssl rand -base64 32)
SESSION_SECRET=
# Production only — share session across *.altagroup.dev (leave unset for localhost)
# ALTA_COOKIE_DOMAIN=.altagroup.dev

# =============================================================================
# Alta Accounting (private — corporate_admin only; not in ecosystem/footers)
# =============================================================================
# Host: accounting.altagroup.dev (same altaweb deploy). Add the OAuth callback above.
# Local: http://accounting.localhost:3000 or http://localhost:3000/accounting?site=accounting
# Do not advertise this product in public navigation.

# =============================================================================
# Discord bots (Communications + Bank integrations)
# =============================================================================
# Bank bot — deal rooms, customer DMs, Bank staff audit, guild roles, Communications → Bank
DISCORD_BANK_BOT_TOKEN=
DISCORD_BANK_GUILD_ID=
# Terminal bot — Terminal staff ops / recon alerts (Phase 4 gateway in altaterminalbot).
# Never reuse for OAuth or Bank/Secretary delivery.
DISCORD_TERMINAL_BOT_TOKEN=
DISCORD_TERMINAL_APPLICATION_ID=
DISCORD_TERMINAL_GUILD_ID=
# Bridge: altaweb → altaterminalbot (default http://127.0.0.1:3849)
TERMINAL_BOT_INTERNAL_URL=http://127.0.0.1:3849
TERMINAL_BOT_API_SECRET=

# Alta Secretary bot — same Discord application as website OAuth (see DISCORD_CLIENT_*).
# Used for Communications → Secretary, platform ops / security / delivery alerts (Phase 3),
# and OAuth identify. Never reuse DISCORD_BANK_BOT_TOKEN / DISCORD_TERMINAL_BOT_TOKEN.
DISCORD_SECRETARY_BOT_TOKEN=
DISCORD_SECRETARY_APPLICATION_ID=
DISCORD_SECRETARY_GUILD_ID=
# Legacy alias for DISCORD_SECRETARY_BOT_TOKEN (same app; prefer SECRETARY name).
# DISCORD_CORPORATE_BOT_TOKEN=
# Bridge: altaweb → altasecretarybot (default http://127.0.0.1:3848)
SECRETARY_BOT_INTERNAL_URL=http://127.0.0.1:3848
SECRETARY_BOT_API_SECRET=

# =============================================================================
# Discord Bank integrations (channels / roles)
# =============================================================================
# Staff audit channel — plain-text real-time ops visibility (optional)
DISCORD_STAFF_AUDIT_CHANNEL_ID=
# Secure Deal Room private Discord channels
DISCORD_DEAL_ROOM_CATEGORY_ID=
DISCORD_CLOSED_DEAL_ROOM_CATEGORY_ID=
# Comma-separated staff role IDs with access to Deal Room channels
DISCORD_DEAL_ROOM_STAFF_ROLE_IDS=
# Guild roles granted on membership events (optional)
# Prefer DISCORD_BANK_CLIENT_ROLE_ID (DISCORD_CLIENT_ROLE_ID is a legacy alias).
DISCORD_BANK_CLIENT_ROLE_ID=
DISCORD_CLIENT_ROLE_ID=
# Phase 5 product roles (role IDs are authority — never role names)
DISCORD_TERMINAL_INVESTOR_ROLE_ID=
DISCORD_SECRETARY_STAFF_ROLE_ID=
# Master switch for durable role grant/revoke/reconcile via outbox
# DISCORD_ROLE_SYNC_ENABLED=true

# =============================================================================
# Bot bridge (must match altabankbot)
# =============================================================================
BOT_INTERNAL_URL=http://127.0.0.1:3847
BOT_API_SECRET=

# Discord outbox Phase 1 — dual-write durable DiscordOutbox beside Bank dispatch.
# When true: enqueue outbox rows for customer DMs + staff audit; operational-controls
# processes PENDING rows (after a short grace period).
# DISCORD_OUTBOX_DUAL_WRITE=true

# Discord Phase 2 — product-aware routing.
# When true: registry drives product/channel class; Terminal staff messages require
# DISCORD_TERMINAL_STAFF_AUDIT_CHANNEL_ID (no silent fallback to Bank staff channel).
# DISCORD_PRODUCT_AWARE_ROUTING=true
# DISCORD_STRICT_EVENT_REGISTRY=1

# Discord Phase 3 — Secretary delivery cutover.
# When true: secretary/ops/corporate staff + delivery alerts enqueue with targetBot=secretary
# and are claimed only by the Secretary outbox worker. Customer DMs stay on Bank.
# Rollback: set false/unset so new rows target Bank again.
# DISCORD_SECRETARY_DELIVERY=true

# Discord Phase 7A — Central Secretary audit fan-out.
# When true (with DISCORD_OUTBOX_DUAL_WRITE): Bank/Terminal staff events also enqueue a
# redacted Secretary audit destination (`:destination:secretary`). Customer DMs never fan out.
# Secretary-owned events stay single-destination. Default off preserves Phase 1–6 behavior.
# DISCORD_SECRETARY_AUDIT_FANOUT=false

# Discord Phase 7B — Premium Bank / Terminal product notification embeds.
# When true: customer DMs and Bank/Terminal staff audits use typed premium embeds
# (shared buildPremiumEmbed). Default off keeps legacy notification-dm title-color embeds.
# DISCORD_PRODUCT_PREMIUM_EMBEDS=false

# Discord Phase 8 — Production hardening.
# Stale PROCESSING recovery runs with operational-controls outbox workers.
# Internal Discord operations panel: readiness, outbox retry/replay, role reconcile.
# Exact registry coverage for Discord-bound staff audits (no silent Bank prefix default).
# No new env flag required; use the Phase 1–7B flags above. Defaults remain safe/off.

# Discord Phase 5 — product role sync + premium embeds.
# When true: role_mgmt outbox rows are enqueued for grant/revoke/reconcile.
# Revocation is conservative (only when eligibility is actually lost).
# DISCORD_ROLE_SYNC_ENABLED=true

# Discord Phase 4 — Terminal delivery cutover.
# When true: Terminal-owned staff events enqueue with targetBot=terminal and are claimed
# only by the Terminal outbox worker. Missing Terminal channel/config fails closed
# (never silently falls back to Bank/Secretary). Customer DMs stay on Bank.
# Rollback: set false/unset so new Terminal staff rows target Bank again.
# DISCORD_TERMINAL_DELIVERY=true

# Test-only — disables all live Discord HTTP/bot handoffs. NEVER set in production.
# DISCORD_TEST_MODE=1

# Product staff / alert channels (do not hardcode IDs in code)
# DISCORD_STAFF_AUDIT_CHANNEL_ID=          # Bank staff (legacy default)
# DISCORD_TERMINAL_STAFF_AUDIT_CHANNEL_ID=
# DISCORD_SECRETARY_STAFF_AUDIT_CHANNEL_ID=
# DISCORD_SECURITY_ALERT_CHANNEL_ID=
# DISCORD_DELIVERY_FAILURE_CHANNEL_ID=

# =============================================================================
# App / public URLs
# =============================================================================
# Public site URL for Discord notification link buttons (defaults to https://altagroup.dev when unset)
ALTA_WEB_BASE_URL=http://localhost:3000
# Public Discord invite URLs (optional — enables automatic redirect from /discord routes)
VITE_ALTA_GROUP_DISCORD_URL=
VITE_ALTA_BANK_DISCORD_URL=
VITE_ALTA_TERMINAL_DISCORD_URL=

# =============================================================================
# Cron
# =============================================================================
# Cron job authentication (server-only — scheduled transfer auto-execution)
CRON_SECRET=
# Local cron smoke tests only (scripts/test-ftlceo-invoices-and-crons.ts)
CRON_TEST_BASE=http://localhost:3000

# =============================================================================
# Storage (Vercel Blob)
# =============================================================================
# Deposit/withdrawal proof screenshots (server-only)
BLOB_READ_WRITE_TOKEN=
# Match your Blob store type: "public" (default) or "private"
BLOB_ACCESS=public

# =============================================================================
# Admin Copilot (server-only — never expose keys to the browser)
# =============================================================================
# Phase 2: real AI tool-calling for internal read-only lookup/navigation.
# ADMIN_COPILOT_ENABLED=false disables the assistant entirely.
# ADMIN_COPILOT_REQUIRE_AI=true shows unavailable when no provider key is set
# (never silently falls back to text matching).
# ADMIN_COPILOT_PROVIDER=openai|anthropic
# ADMIN_COPILOT_MODEL=gpt-4o-mini  (or claude-sonnet-4-20250514)
# For Groq free tier, prefer a small model and expect TPM limits — Copilot site-scopes
# tools and skips a prose round when tool results already answer the query.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ADMIN_COPILOT_AI_API_KEY=   # optional generic key when PROVIDER is set
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# =============================================================================
# UI Lab (DO NOT ENABLE IN PRODUCTION)
# =============================================================================
# Bypass auth & inject mock user for design preview (see docs/ui-lab-mode.md)
VITE_UI_LAB_MODE=false

# Alta Terminal TSE adapter: unavailable (default) | live (reserved; fails closed until Newport wired)
# TERMINAL_TSE_MODE=unavailable
# Do not use mock mode for ordinary development. UI Lab uses VITE_UI_LAB_MODE only.

# Alta Terminal crypto quote fingerprints (HMAC). Server-only — never log or expose.
# Production: REQUIRED before crypto can become operational (min 32 characters).
# Missing/short production secret fails closed (customer-safe unavailable).
# Generate with: openssl rand -base64 32
# Local/test/dev may omit; code may fall back to SESSION_SECRET then a fixed local secret.
TERMINAL_CRYPTO_QUOTE_SECRET=

# Destination Terminal portfolio for corporate crypto trading revenue sweeps (Phase 4).
# Must be an ACTIVE Terminal portfolio suitable for Alta corporate florin revenue.
# Sweeps credit Terminal cash only — no Bank transfer, and never touch protected reserves,
# stabilization, customer wallets, or treasury inventory.
# Leave empty to show accrued revenue while disabling Sweep until configured.
TERMINAL_CRYPTO_REVENUE_PORTFOLIO_ID=

# =============================================================================
# E2E / local test
# =============================================================================
# Playwright E2E (local/test only — see tests/e2e/README.md)
E2E_BASE_URL=http://localhost:3000
E2E_TEST_MODE=false
